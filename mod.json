{
	"geode": "5.7.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081"
	},
	"id": "sawblade.dim_mode",
	"links": {
		"source": "https://github.com/SawBlade21/dim-level"
	},
	"name": "Dim Level",
	"version": "v1.0.5",
	"developer": "Sawblade",
	"description": "Dims the screen while playing a level.",
	"resources": {
		"sprites": [
				"resources/dim_btn.png"
			]
	},
	"settings": {
		"enable-overlay": {
			"name": "Enable Dim Overlay",
			"description": "Enables the overlay that dims the screen.",
			"type": "bool",
			"default": true
		},
		"set-opacity": {
			"name": "Opacity (%)",
			"description": "Sets the dimness of the screen.",
			"type": "int",
			"default": 50,
			"min": 0,
			"max": 100,
			"control": {
                "slider": true
            }
		},
		"overlay-color": {
		"type": "rgb",
		"name": "Overlay Color",
		"description": "Sets the color of the screen overlay.",
		"default": "#000000"
		},
		"rgb": {
			"name": "RGB",
			"type": "bool",
			"description": "Makes the overlay RGB.",
			"default": false
		},
		"rgb-speed": {
			"name": "RGB Speed",
			"description": "How fast the color changes.",
			"type": "float",
			"default": 5,
			"min": 0.1,
			"max": 10,
			"control": {
				"arrows": true,
        		"arrow-step": 0.1,
        		"big-arrows": false,
        		"big-arrow-step": 0.5,
        		"slider": true,
        		"slider-step": 0.1,
        		"input": true
    		}
		},
		"show-opacity-button": {
			"name": "Show Settings Button",
			"description": "Shows the mod settings button in the pause menu.",
			"type": "bool",
			"default": true
		},
		"toggle-overlay": {
			"type": "keybind",
			"name": "Toggle Overlay",
			"description": "Toggles overlay visibility",
			"default": "Alt+O"
		},
		"toggle-rgb": {
			"type": "keybind",
			"name": "Toggle RGB",
			"description": "Toggles the RGB setting",
			"default": "Alt+P"
		},
		"increase-opacity": {
			"type": "keybind",
			"name": "Increase Opacity",
			"description": "Increases the opacity of the overlay",
			"default": "Alt+I"
		},
		"decrease-opacity": {
			"type": "keybind",
			"name": "Decrease Opacity",
			"description": "Decreases the opacity of the overlay",
			"default": "Alt+U"
		}
	},
	"dependencies": {
		"geode.node-ids": {
			"version": ">=v1.23.3"
		}
	},
	"tags": [
		"gameplay",
		"offline",
		"utility",
		"customization"
	]
}
